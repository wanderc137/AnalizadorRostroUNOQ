[26.139, "o", "\u001b[90m 381\u001b[0m\u001b[90m │ \u001b[0m        height=settings.height,\u001b[90m\u001b[39;49;00m\n"]
[26.194, "o", "\u001b[90m 382\u001b[0m\u001b[90m │ \u001b[0m        fps_target=settings.fps_target,\u001b[90m\u001b[39;49;00m\n"]
[26.249, "o", "\u001b[90m 383\u001b[0m\u001b[90m │ \u001b[0m    )\u001b[90m\u001b[39;49;00m\n"]
[26.304, "o", "\u001b[90m 384\u001b[0m\u001b[90m │ \u001b[0m    model = load_model(settings)\u001b[90m\u001b[39;49;00m\n"]
[26.359, "o", "\u001b[90m 385\u001b[0m\u001b[90m │ \u001b[0m    detector: Optional[FaceDetector] = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[26.414, "o", "\u001b[90m 386\u001b[0m\u001b[90m │ \u001b[0m    detector_error = \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[26.469, "o", "\u001b[90m 387\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[26.524, "o", "\u001b[90m 388\u001b[0m\u001b[90m │ \u001b[0m        detector = FaceDetector(\u001b[90m\u001b[39;49;00m\n"]
[26.579, "o", "\u001b[90m 389\u001b[0m\u001b[90m │ \u001b[0m            model,\u001b[90m\u001b[39;49;00m\n"]

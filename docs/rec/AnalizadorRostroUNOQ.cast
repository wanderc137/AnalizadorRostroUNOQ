[26.854, "o", "\u001b[90m 394\u001b[0m\u001b[90m │ \u001b[0m        detector_error = \u001b[96mstr\u001b[39;49;00m(exc)\u001b[90m\u001b[39;49;00m\n"]
[26.909, "o", "\u001b[90m 395\u001b[0m\u001b[90m │ \u001b[0m        LOG.error(\u001b[33m\"\u001b[39;49;00m\u001b[33mNo se pudo inicializar el detector Haar: \u001b[39;49;00m\u001b[33m%s\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, exc)\u001b[90m\u001b[39;49;00m\n"]

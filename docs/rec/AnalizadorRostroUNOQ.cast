[25.974, "o", "\u001b[90m 378\u001b[0m\u001b[90m │ \u001b[0m    camera = Camera(\u001b[90m\u001b[39;49;00m\n"]
[26.029, "o", "\u001b[90m 379\u001b[0m\u001b[90m │ \u001b[0m        source=settings.camera_source \u001b[95mor\u001b[39;49;00m settings.camera_index,\u001b[90m\u001b[39;49;00m\n"]

[134.379, "o", "\u001b[90m┌─ app/main.py · _check_api_token() ────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[134.379, "o", "\u001b[90m 402\u001b[0m\u001b[90m │ \u001b[0m\u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_check_api_token\u001b[39;49;00m(cfg: Settings, request: Request) -> \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[134.434, "o", "\u001b[90m 403\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m    \u001b[39;49;00m\u001b[33m\"\"\"Exige ``X-Api-Token`` en endpoints de escritura si ``API_TOKEN`` existe.\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[134.489, "o", "\u001b[90m 404\u001b[0m\u001b[90m │ \u001b[0m    expected = cfg.api_token\u001b[90m\u001b[39;49;00m\n"]
[134.544, "o", "\u001b[90m 405\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m expected:\u001b[90m\u001b[39;49;00m\n"]
[134.599, "o", "\u001b[90m 406\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[134.654, "o", "\u001b[90m 407\u001b[0m\u001b[90m │ \u001b[0m    provided = request.headers.get(\u001b[33m\"\u001b[39;49;00m\u001b[33mx-api-token\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, \u001b[33m\"\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[134.709, "o", "\u001b[90m 408\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mif\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m provided \u001b[95mor\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m hmac.compare_digest(\u001b[90m\u001b[39;49;00m\n"]
[134.764, "o", "\u001b[90m 409\u001b[0m\u001b[90m │ \u001b[0m        provided.encode(\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m), expected.encode(\u001b[33m\"\u001b[39;49;00m\u001b[33mutf-8\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m)\u001b[90m\u001b[39;49;00m\n"]
[134.819, "o", "\u001b[90m 410\u001b[0m\u001b[90m │ \u001b[0m    ):\u001b[90m\u001b[39;49;00m\n"]
[134.874, "o", "\u001b[90m 411\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mraise\u001b[39;49;00m HTTPException(\u001b[90m\u001b[39;49;00m\n"]
[134.929, "o", "\u001b[90m 412\u001b[0m\u001b[90m │ \u001b[0m            status_code=\u001b[94m401\u001b[39;49;00m,\u001b[90m\u001b[39;49;00m\n"]
[134.984, "o", "\u001b[90m 413\u001b[0m\u001b[90m │ \u001b[0m            detail=(\u001b[90m\u001b[39;49;00m\n"]
[135.039, "o", "\u001b[90m 414\u001b[0m\u001b[90m │ \u001b[0m                \u001b[33m\"\u001b[39;49;00m\u001b[33mToken de API ausente o inválido. \u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[135.094, "o", "\u001b[90m 415\u001b[0m\u001b[90m │ \u001b[0m                \u001b[33m\"\u001b[39;49;00m\u001b[33mEnvía el header X-Api-Token con el valor de API_TOKEN.\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[135.149, "o", "\u001b[90m 416\u001b[0m\u001b[90m │ \u001b[0m            ),\u001b[90m\u001b[39;49;00m\n"]
[135.204, "o", "\u001b[90m 417\u001b[0m\u001b[90m │ \u001b[0m            headers={\u001b[33m\"\u001b[39;49;00m\u001b[33mWWW-Authenticate\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m: \u001b[33m'\u001b[39;49;00m\u001b[33mApiToken realm=\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33mAnalizadorRostroUNOQ\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m'\u001b[39;49;00m},\u001b[90m\u001b[39;49;00m\n"]
[135.259, "o", "\u001b[90m 418\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]

[104.736, "o", "\n"]
[104.736, "o", "\u001b[90m┌─ app/detector.py · _label_for() ──────────────────────────────────────────────────────────────────────\u001b[0m\n"]
[104.736, "o", "\u001b[90m 127\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92m_label_for\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, face: FaceResult) -> Tuple[\u001b[96mstr\u001b[39;49;00m, \u001b[96mfloat\u001b[39;49;00m]:\u001b[90m\u001b[39;49;00m\n"]
[104.791, "o", "\u001b[90m 128\u001b[0m\u001b[90m │ \u001b[0m        prediction = face.prediction\u001b[90m\u001b[39;49;00m\n"]
[104.846, "o", "\u001b[90m 129\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m prediction \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[104.901, "o", "\u001b[90m 130\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m NO_MODEL_LABEL, \u001b[94m0.0\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[104.956, "o", "\u001b[90m 131\u001b[0m\u001b[90m │ \u001b[0m        gender = prediction.gender\u001b[90m\u001b[39;49;00m\n"]
[105.011, "o", "\u001b[90m 132\u001b[0m\u001b[90m │ \u001b[0m        age = prediction.age\u001b[90m\u001b[39;49;00m\n"]
[105.066, "o", "\u001b[90m 133\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# La etiqueta del vídeo y la recomendación del frontend deben contar\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[105.121, "o", "\u001b[90m 134\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# la misma historia: si la confianza es baja, se muestra la clase\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[105.176, "o", "\u001b[90m 135\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# estimada con \"~\" y \"?\" en lugar de ocultarla por completo.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[105.231, "o", "\u001b[90m 136\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m prediction.gender_conf < \u001b[96mself\u001b[39;49;00m.conf_threshold:\u001b[90m\u001b[39;49;00m\n"]
[105.286, "o", "\u001b[90m 137\u001b[0m\u001b[90m │ \u001b[0m            gender = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m~\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mprediction.gender\u001b[33m}\u001b[39;49;00m\u001b[33m?\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[105.341, "o", "\u001b[90m 138\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m prediction.age_conf < \u001b[96mself\u001b[39;49;00m.conf_threshold:\u001b[90m\u001b[39;49;00m\n"]
[105.396, "o", "\u001b[90m 139\u001b[0m\u001b[90m │ \u001b[0m            age = \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m~\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mprediction.age\u001b[33m}\u001b[39;49;00m\u001b[33m?\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[105.451, "o", "\u001b[90m 140\u001b[0m\u001b[90m │ \u001b[0m        percent = \u001b[96mint\u001b[39;49;00m(\u001b[96mround\u001b[39;49;00m(\u001b[96mmax\u001b[39;49;00m(\u001b[94m0.0\u001b[39;49;00m, \u001b[96mmin\u001b[39;49;00m(\u001b[94m1.0\u001b[39;49;00m, prediction.confidence)) * \u001b[94m100\u001b[39;49;00m))\u001b[90m\u001b[39;49;00m\n"]
[105.506, "o", "\u001b[90m 141\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m \u001b[33mf\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mgender\u001b[33m}\u001b[39;49;00m\u001b[33m | \u001b[39;49;00m\u001b[33m{\u001b[39;49;00mage\u001b[33m}\u001b[39;49;00m\u001b[33m (\u001b[39;49;00m\u001b[33m{\u001b[39;49;00mpercent\u001b[33m}\u001b[39;49;00m\u001b[33m%)\u001b[39;49;00m\u001b[33m\"\u001b[39;49;00m, prediction.confidence\u001b[90m\u001b[39;49;00m\n"]

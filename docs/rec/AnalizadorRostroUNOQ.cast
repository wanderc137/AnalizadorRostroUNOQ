[75.625, "o", "\u001b[90m┌─ app/detector.py · FaceDetector.detect() ─────────────────────────────────────────────────────────────\u001b[0m\n"]
[75.625, "o", "\u001b[90m  95\u001b[0m\u001b[90m │ \u001b[0m    \u001b[94mdef\u001b[39;49;00m\u001b[90m \u001b[39;49;00m\u001b[92mdetect\u001b[39;49;00m(\u001b[96mself\u001b[39;49;00m, frame: np.ndarray) -> List[FaceResult]:\u001b[90m\u001b[39;49;00m\n"]
[75.68, "o", "\u001b[90m  96\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m        \u001b[39;49;00m\u001b[33m\"\"\"Detecta rostros y clasifica cada ROI (si hay modelo cargado).\"\"\"\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[75.735, "o", "\u001b[90m  97\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mif\u001b[39;49;00m frame \u001b[95mis\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m \u001b[95mor\u001b[39;49;00m frame.size == \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[75.79, "o", "\u001b[90m  98\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mreturn\u001b[39;49;00m []\u001b[90m\u001b[39;49;00m\n"]
[75.845, "o", "\u001b[90m  99\u001b[0m\u001b[90m │ \u001b[0m        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)\u001b[90m\u001b[39;49;00m\n"]
[75.9, "o", "\u001b[90m 100\u001b[0m\u001b[90m │ \u001b[0m        gray = cv2.equalizeHist(gray)\u001b[90m\u001b[39;49;00m\n"]
[75.955, "o", "\u001b[90m 101\u001b[0m\u001b[90m │ \u001b[0m        boxes = \u001b[96mself\u001b[39;49;00m._cascade.detectMultiScale(\u001b[90m\u001b[39;49;00m\n"]
[76.01, "o", "\u001b[90m 102\u001b[0m\u001b[90m │ \u001b[0m            gray,\u001b[90m\u001b[39;49;00m\n"]
[76.065, "o", "\u001b[90m 103\u001b[0m\u001b[90m │ \u001b[0m            scaleFactor=\u001b[96mself\u001b[39;49;00m.scale_factor,\u001b[90m\u001b[39;49;00m\n"]
[76.12, "o", "\u001b[90m 104\u001b[0m\u001b[90m │ \u001b[0m            minNeighbors=\u001b[96mself\u001b[39;49;00m.min_neighbors,\u001b[90m\u001b[39;49;00m\n"]
[76.175, "o", "\u001b[90m 105\u001b[0m\u001b[90m │ \u001b[0m            minSize=\u001b[96mself\u001b[39;49;00m.min_size,\u001b[90m\u001b[39;49;00m\n"]
[76.23, "o", "\u001b[90m 106\u001b[0m\u001b[90m │ \u001b[0m        )\u001b[90m\u001b[39;49;00m\n"]
[76.285, "o", "\u001b[90m 107\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[76.34, "o", "\u001b[90m 108\u001b[0m\u001b[90m │ \u001b[0m        results: List[FaceResult] = []\u001b[90m\u001b[39;49;00m\n"]
[76.395, "o", "\u001b[90m 109\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mfor\u001b[39;49;00m raw_box \u001b[95min\u001b[39;49;00m boxes:\u001b[90m\u001b[39;49;00m\n"]
[76.45, "o", "\u001b[90m 110\u001b[0m\u001b[90m │ \u001b[0m            box = (\u001b[96mint\u001b[39;49;00m(raw_box[\u001b[94m0\u001b[39;49;00m]), \u001b[96mint\u001b[39;49;00m(raw_box[\u001b[94m1\u001b[39;49;00m]), \u001b[96mint\u001b[39;49;00m(raw_box[\u001b[94m2\u001b[39;49;00m]), \u001b[96mint\u001b[39;49;00m(raw_box[\u001b[94m3\u001b[39;49;00m]))\u001b[90m\u001b[39;49;00m\n"]
[76.505, "o", "\u001b[90m 111\u001b[0m\u001b[90m │ \u001b[0m            prediction: Optional[FacePrediction] = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[76.56, "o", "\u001b[90m 112\u001b[0m\u001b[90m │ \u001b[0m            \u001b[94mif\u001b[39;49;00m \u001b[96mself\u001b[39;49;00m.model.loaded:\u001b[90m\u001b[39;49;00m\n"]
[76.615, "o", "\u001b[90m 113\u001b[0m\u001b[90m │ \u001b[0m                roi = \u001b[96mself\u001b[39;49;00m._crop_with_margin(frame, box)\u001b[90m\u001b[39;49;00m\n"]
[76.67, "o", "\u001b[90m 114\u001b[0m\u001b[90m │ \u001b[0m                \u001b[94mif\u001b[39;49;00m roi \u001b[95mis\u001b[39;49;00m \u001b[95mnot\u001b[39;49;00m \u001b[94mNone\u001b[39;49;00m \u001b[95mand\u001b[39;49;00m roi.size > \u001b[94m0\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[76.725, "o", "\u001b[90m 115\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mtry\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[76.78, "o", "\u001b[90m 116\u001b[0m\u001b[90m │ \u001b[0m                        prediction = \u001b[96mself\u001b[39;49;00m.model.predict(roi)\u001b[90m\u001b[39;49;00m\n"]
[76.835, "o", "\u001b[90m 117\u001b[0m\u001b[90m │ \u001b[0m                    \u001b[94mexcept\u001b[39;49;00m \u001b[96mException\u001b[39;49;00m:\u001b[90m\u001b[39;49;00m\n"]
[76.89, "o", "\u001b[90m 118\u001b[0m\u001b[90m │ \u001b[0m                        prediction = \u001b[94mNone\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[76.945, "o", "\u001b[90m 119\u001b[0m\u001b[90m │ \u001b[0m            results.append(FaceResult(box=box, prediction=prediction))\u001b[90m\u001b[39;49;00m\n"]
[77.0, "o", "\u001b[90m 120\u001b[0m\u001b[90m │ \u001b[0m\u001b[90m\u001b[39;49;00m\n"]
[77.055, "o", "\u001b[90m 121\u001b[0m\u001b[90m │ \u001b[0m        \u001b[90m# Orden estable de izquierda a derecha para que el overlay no parpadee.\u001b[39;49;00m\u001b[90m\u001b[39;49;00m\n"]
[77.11, "o", "\u001b[90m 122\u001b[0m\u001b[90m │ \u001b[0m        results.sort(key=\u001b[94mlambda\u001b[39;49;00m item: (item.box[\u001b[94m1\u001b[39;49;00m] // \u001b[94m40\u001b[39;49;00m, item.box[\u001b[94m0\u001b[39;49;00m]))\u001b[90m\u001b[39;49;00m\n"]
[77.165, "o", "\u001b[90m 123\u001b[0m\u001b[90m │ \u001b[0m        \u001b[94mreturn\u001b[39;49;00m results\u001b[90m\u001b[39;49;00m\n"]

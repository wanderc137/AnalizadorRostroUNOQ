# Cámara
CAMERA_INDEX=0
WIDTH=640
HEIGHT=480
FPS_TARGET=15

# Servidor
HOST=0.0.0.0
PORT=8000

# Modelo: auto | utkface_onnx | caffe
MODEL_BACKEND=auto

# Rutas modelo propio UTKFace (ONNX)
UTKFACE_ONNX_PATH=models/utkface_mobilenetv2.onnx

# Rutas modelo fallback Caffe
CAFFE_AGE_PROTO=models/fallback/deploy_age.prototxt
CAFFE_AGE_MODEL=models/fallback/age_net.caffemodel
CAFFE_GENDER_PROTO=models/fallback/deploy_gender.prototxt
CAFFE_GENDER_MODEL=models/fallback/gender_net.caffemodel

# Inferencia
INFER_EVERY_N=5
CONF_THRESHOLD=0.6

# Haar cascade (vacío = usar el incluido en opencv-python)
HAAR_PATH=

# Snapshots (vacío = deshabilitado por privacidad).
# Debe ser una subcarpeta del proyecto; las rutas que escapen del árbol
# del proyecto (../, absolutas externas) se rechazan con HTTP 400.
SNAP_FOLDER=

# Intervalo mínimo entre snapshots en segundos (rate-limit -> HTTP 429)
SNAPSHOT_MIN_INTERVAL=2

# Buckets de edad (orden fijo del modelo propio)
AGE_BUCKETS=0-2,3-9,10-19,20-29,30-39,40-49,50-59,60+

# Calidad JPEG del stream (30-95, opcional)
JPEG_QUALITY=80

# Seguridad opcional: si defines API_TOKEN, los POST a /api/snapshot y
# /api/camera/start|stop exigen el header "X-Api-Token: <valor>".
# Vacío = sin autenticación (solo recomendable en red de confianza).
API_TOKEN=
